#!/usr/bin/env python3
"""
detach-ebpf-probe: OCI poststop hook.
Kills the bpftrace process attached during createRuntime and cleans up state.
Receives container state JSON on stdin per the OCI runtime spec.
"""

import json
import os
import signal
import sys
import time
from pathlib import Path

LOGFILE   = Path("/var/log/ebpf-container-trace.log")
STATE_DIR = Path("/var/run/ebpf-hooks")


def log(message: str, container_id: str = "") -> None:
    prefix = f"[{container_id}] " if container_id else ""
    entry  = f"{time.strftime('%c')} {prefix}{message}\n"
    with LOGFILE.open("a") as f:
        f.write(entry)


def read_container_state() -> dict:
    """OCI runtime hooks receive container state as JSON on stdin."""
    return json.load(sys.stdin)


def read_probe_pid(container_id: str) -> int | None:
    """
    Retrieve the bpftrace PID stored by attach-ebpf-probe.
    Returns None if no state file exists — this is normal if the
    attach hook failed or timed out during container startup.
    """
    state_file = STATE_DIR / container_id
    if not state_file.exists():
        return None
    return int(state_file.read_text().strip())

def stop_probe(bpftrace_pid: int, container_id: str) -> None:
    """
    Send SIGTERM to the bpftrace process.
    bpftrace handles SIGTERM cleanly — it flushes its END block,
    which calls clear() on the @children and @fname maps before exiting.
    """
    try:
        os.kill(bpftrace_pid, signal.SIGTERM)
        log(f"Sent SIGTERM to bpftrace PID {bpftrace_pid}", container_id)
    except ProcessLookupError:
        # Process already exited — normal for short-lived containers
        log(f"bpftrace PID {bpftrace_pid} already exited", container_id)


def cleanup_state(container_id: str) -> None:
    """Remove the PID state file for this container."""
    state_file = STATE_DIR / container_id
    state_file.unlink(missing_ok=True)
    log("State file removed", container_id)


def sweep_orphans() -> None:
    """
    Remove state files whose bpftrace processes are no longer running.
    Guards against stale entries left by unexpected host-side failures
    such as a killed hook process or a crashed bpftrace instance.
    """
    if not STATE_DIR.exists():
        return
    for state_file in STATE_DIR.iterdir():
        try:
            pid = int(state_file.read_text().strip())
            os.kill(pid, 0)  # signal 0 checks existence without killing
        except (ProcessLookupError, ValueError):
            state_file.unlink(missing_ok=True)


def main() -> int:
    state        = read_container_state()
    container_id = state["id"]

    log(f"poststop: cleaning up probe for container", container_id)

    bpftrace_pid = read_probe_pid(container_id)

    if bpftrace_pid is None:
        log("No bpftrace PID found — nothing to clean up", container_id)
        sweep_orphans()
        return 0
    stop_probe(bpftrace_pid, container_id)
    cleanup_state(container_id)
    sweep_orphans()

    return 0


if __name__ == "__main__":
    sys.exit(main())

